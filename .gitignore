# Dependencies
node_modules

# Secrets — .env alone does NOT match .env.local
.env
.env.*
!.env.example

# Build output
/.next
/dist
/out
*.tsbuildinfo

# Generated media (pipeline output, not source).
public/renders
public/voiceovers
public/uploads

# Background music. Generated tracks are output, and any licensed tracks you
# add are yours to keep out of the repo — the mp3s that used to live here were
# someone else's recordings and drew a Content ID claim.
public/music

# Runtime state, recreated on demand by the file stores.
# Leading slash matters: an unanchored "data" would also swallow src/data.
/data

# SQLite database. Schema lives in prisma/migrations and is tracked; the
# database itself is local state — rebuild it with `npm run db:deploy`.
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor / OS
.idea
.DS_Store

# Agent tooling. .agents/ and .claude/skills hold real content and stay tracked;
# everything below is empty per-tool local config.
.claude/worktrees
.agent/
.cline/
.codebuddy/
.codex/
.commandcode/
.continue/
.crush/
.cursor/
.factory/
.gemini/
.goose/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.opencode/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.windsurf/
.zencoder/

# Logs and scratch files
npm-debug.log*
yarn-error.log*
scratch_*

/src/generated/prisma

# Rendered sample cards (output of `npm run cards`).
public/card-samples
