// Persistence for the reel factory.
//
// Replaces the previous split-brain storage: localStorage for series/reels
// (which silently evicted the oldest reels at the 5MB quota) and
// data/reels.json for the preset pipeline.
//
// Two rules this schema enforces by shape:
//   1. Media is referenced by PATH, never inlined. Base64 data URLs in
//      localStorage were what blew the quota.
//   2. Render jobs are rows, not an in-memory object, so they survive restarts.
//
// SQLite has no enums or array columns. Unions are stored as String and
// structured values as JSON text; the accessor layer in src/lib/db does the
// encoding so callers still work with real types.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Series {
  id     String @id @default(uuid())
  name   String
  niche  String
  status String @default("active") // active | paused

  // Generation defaults inherited by each reel in the series
  artStyle             String
  voiceId              String
  language             String  @default("english")
  targetDuration       Int     @default(60) // seconds
  frequency            String  @default("manual") // daily | weekly | manual
  usePremiumImageStack Boolean @default(false)
  // slideshow | hybrid | motion — what fills each shot. See src/lib/pipeline/format.ts
  format               String  @default("slideshow")
  seriesContext        String?
  visualStylePrompt    String?

  targetPlatforms String @default("[]") // JSON: ("tiktok"|"instagram"|"youtube")[]
  musicSettings   String // JSON: { enabled, trackId, volume }
  captionStyle    String // JSON: { type, animation, color, fontSize, fontFamily, boxEnabled, yOffset? }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reels      Reel[]
  topicIdeas TopicIdea[]

  @@index([status])
}

model Reel {
  id       String @id @default(uuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  title  String
  script String @default("")

  brandColor  String @default("#6366f1")
  accentColor String @default("#facc15")

  // Per-reel overrides of the series defaults
  language             String?
  artStyle             String?
  visualStyleOverride  String?
  usePremiumImageStack Boolean @default(false)
  format               String? // overrides the series format when set
  seed                 Int?

  // Path under public/, e.g. /voiceovers/voice-123.mp3 — never a data URL.
  voiceoverPath    String?
  actualDurationMs Int?
  captionWords     String? // JSON: { word, start, end }[]

  // pending | scripted | voicing | visualizing | rendering | completed | failed
  generationStatus String  @default("pending")
  generationError  String?

  musicSettings String? // JSON, falls back to the series setting when null
  captionStyle  String? // JSON, falls back to the series setting when null

  scheduledFor DateTime?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  scenes     Scene[]
  renderJobs RenderJob[]

  @@index([seriesId])
  @@index([generationStatus])
  @@index([scheduledFor])
}

model Scene {
  id     String @id @default(uuid())
  reelId String
  reel   Reel   @relation(fields: [reelId], references: [id], onDelete: Cascade)

  // Position in the reel. Scene order is explicit rather than implied by id.
  index Int

  type          String  @default("hook") // hook | problem | reaction | offer | proof | cta
  headline      String
  narrationText String?
  visualPrompt  String?

  backgroundPath String? // path under public/, or a remote URL for generated images
  backgroundType String? @default("image") // image | video

  // Set by the shot planner: how this shot frames the subject, and — for a
  // motion shot — what the clip should actually do.
  shotType     String? // wide | medium | close | detail
  motionPrompt String?

  durationInSeconds Float @default(3)

  // Absolute timeline position, set once voiceover timings are known.
  startMs Int?
  endMs   Int?

  @@unique([reelId, index])
  @@index([reelId])
}

model RenderJob {
  id     String @id @default(uuid())
  reelId String
  reel   Reel   @relation(fields: [reelId], references: [id], onDelete: Cascade)

  status   String @default("queued") // queued | processing | completed | failed
  progress Int    @default(0) // 0-100

  outputPath String? // path under public/, e.g. /renders/<reelId>/<id>.mp4
  error      String?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([reelId])
  @@index([status])
}

model Asset {
  id       String @id @default(uuid())
  fileName String
  url      String
  type     String @default("image") // image | video

  createdAt DateTime @default(now())
}

// A planned topic, waiting for its turn.
//
// Before this, every scheduled reel was generated from `Series.niche` — the
// same one line, run after run, with no memory of the previous thirty reels.
// The writer re-picked a subject each time and converged on the obvious ones,
// which is how a channel ends up with four reels about the same battle.
//
// A topic is written once, in a batch, by a planner that can see what has
// already been made and what is being searched for this week. The queue is a
// table rather than a prompt instruction so that it can be reordered, edited
// and — above all — deduplicated by the database instead of by asking a model
// not to repeat itself.
model TopicIdea {
  id       String @id @default(uuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // The title as it should appear on the video: written for the thumbnail and
  // the first second, in the series language.
  title String
  // The entity an image model should depict. A title is not an image subject —
  // see imageSubject() in src/lib/ai/llm.ts for why these are separate.
  subject String
  // The turn this telling takes, so two reels on one figure differ in substance.
  angle String?
  // Why this topic now. Empty for an evergreen pick.
  rationale String?

  // google-trends | youtube | evergreen — what put this in the queue.
  trendSource String @default("evergreen")
  // The planner's own 0-100 confidence that this earns a slot now.
  score Int @default(50)

  // Normalised title. The unique constraint below is what actually prevents
  // duplicates; the prompt only reduces how often one is proposed.
  dedupeKey String

  status     String    @default("planned") // planned | used | skipped
  sortOrder  Int       @default(0)
  usedReelId String?
  usedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, dedupeKey])
  @@index([seriesId, status, sortOrder])
}
