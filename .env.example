# --- AI REEL PIPELINE CONFIG ---

# SQLite database. Required — the app stores series, reels, scenes and
# render jobs here. Create it with: npm run db:deploy
DATABASE_URL="file:./dev.db"

# --- Text to speech (required) ---
# ElevenLabs is the only voice provider. Without it, generation stops at the
# voiceover stage. The timestamped endpoint is preferred because word timings
# drive caption sync and scene cuts.
ELEVEN_LABS_API_KEY=your_eleven_labs_key_here

# --- Script generation (at least one required) ---
# Tried in order: Anthropic, Groq, Gemini.
ANTHROPIC_API_KEY=your_anthropic_key_here
GROK_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# --- Images (optional, but this is the single biggest quality lever) ---
# FAL_KEY is only used when a series has "premium image stack" switched on.
# Without it — or with the flag off — images come from the free ladder
# (ReelShorts, then Together if TOGETHER_API_KEY is set, then Pollinations),
# and Pollinations is the weakest generator in the chain.
FAL_KEY=your_fal_key_here
TOGETHER_API_KEY=your_together_key_here
# fal's safety checker, 1 (strictest) to 6 (most permissive). The default of 2
# rejects ordinary historical subjects — battlefields, weapons — and returns a
# black frame. 4 suits a history or mythology channel.
# FAL_SAFETY_TOLERANCE=4

# --- Word-level caption timings (optional) ---
# Only used when ElevenLabs returns no timestamps. Deepgram first, then Groq
# Whisper (GROQ_API_KEY, falls back to GROK_API_KEY). Without either, timings
# are estimated from punctuation.
DEEPGRAM_API_KEY=your_deepgram_key_here
GROQ_API_KEY=your_groq_key_here

# --- Topic planning (optional) ---
# The planner reads Google Trends' RSS feed, which needs no key. A YouTube Data
# API key adds the signal that matters more: which titles are already pulling
# views in your niche. Read-only — unrelated to uploading, which needs OAuth.
# search.list costs 100 of 10,000 daily quota units, and one planning run makes
# at most four of those calls.
YOUTUBE_API_KEY=your_youtube_data_api_key_here
# Region for both signals (default IN).
# TRENDS_GEO=IN

# --- Scheduler ---
# How often the worker checks for series due to generate (default 300s).
# WORKER_INTERVAL_SECONDS=300
# Absolute URL used by the renderer to fetch media (default http://localhost:3000)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
