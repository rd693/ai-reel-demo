# --- AI REEL PIPELINE CONFIG ---

# SQLite database. Required — the app stores series, reels, scenes and
# render jobs here. Create it with: npm run db:deploy
DATABASE_URL="file:./dev.db"

# xAI Grok (Primary LLM)
GROK_API_KEY=your_grok_key_here

# Gemini API (Secondary Fallback)
GEMINI_API_KEY=your_gemini_key_here

# Azure Cognitive Services (Text-to-Speech)
# Get a key at: https://portal.azure.com/
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ElevenLabs (Optional Fallback)
ELEVEN_LABS_API_KEY=your_eleven_labs_key_here

# FFmpeg Paths (Optional if not in PATH)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
